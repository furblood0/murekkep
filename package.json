{
  "name": "my-blog-project",
  "version": "1.0.0",
  "description": "Mürekkep — React ve Node.js ile yazılmış bir blog",
  "scripts": {
    "install-all": "npm install && cd frontend && npm install && cd ../blog-backend && npm install",
    "start-backend": "cd blog-backend && npm start",
    "start-frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run start-backend\" \"npm run start-frontend\"",
    "build": "cd frontend && npm run build",
    "seed": "cd blog-backend && npm run seed"
  },
  "keywords": [
    "blog",
    "react",
    "nodejs",
    "express",
    "postgresql",
    "fullstack"
  ],
  "author": "Furkan Fidan",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furblood0/my-blog-project.git"
  },
  "bugs": {
    "url": "https://github.com/furblood0/my-blog-project/issues"
  },
  "homepage": "https://github.com/furblood0/my-blog-project#readme"
}
